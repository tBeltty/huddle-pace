# Runtime Mode (true for single-workspace Socket Mode; false for multi-tenant HTTP OAuth v2)
SOCKET_MODE="true"

# Socket Mode Credentials (required when SOCKET_MODE="true")
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_APP_TOKEN="xapp-your-app-token"

# HTTP & OAuth v2 Credentials (required when SOCKET_MODE="false")
SLACK_SIGNING_SECRET="your-signing-secret"
SLACK_CLIENT_ID="your-client-id"
SLACK_CLIENT_SECRET="your-client-secret"
SLACK_STATE_SECRET="random-high-entropy-string"
SLACK_REDIRECT_URI="https://huddlepace.com/slack/oauth_redirect"

# Database & Server
DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV="development"
