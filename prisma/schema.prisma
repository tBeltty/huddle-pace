datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Meetup {
  id               String         @id @default(uuid())
  teamId           String         @default("default")
  title            String
  channelId        String
  threadTs         String?
  trackerMessageTs String?
  speakerUserId    String
  totalMinutes     Int
  startedAt        DateTime?
  scheduledFor     DateTime?
  formalEndsAt     DateTime?
  endsAt           DateTime?
  status           String         @default("SCHEDULED") // SCHEDULED, ACTIVE, JUST_CHATTING, PAUSED, COMPLETED, CANCELLED
  dmMessageRefs    String? // JSON array of {channel, ts} for speaker DM reminders, cleaned up on conclude
  reminderTextEnabled  Boolean        @default(true)
  reminderImageEnabled Boolean        @default(false)
  modules          MeetupModule[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([teamId, status])
  @@index([channelId, threadTs])
}

model WorkspaceSettings {
  id                   String   @id @default(uuid())
  teamId               String   @unique
  reminderTextEnabled  Boolean  @default(true)
  reminderImageEnabled Boolean  @default(false)
  flexibilityMode      String   @default("STANDARD") // STRICT, STANDARD, RELAXED
  managerUserIds       String?  // Comma-separated Slack user IDs with delegated Bot Manager access
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([teamId])
}

model SlackInstallation {
  id                String   @id @default(uuid())
  teamId            String?  @unique
  enterpriseId      String?
  teamName          String?
  botToken          String?
  botId             String?
  botUserId         String?
  installedByUserId String?
  installationData  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([teamId])
  @@index([enterpriseId])
}

model MeetupModule {
  id              String   @id @default(uuid())
  meetupId        String
  meetup          Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  title           String
  orderIndex      Int
  percentage      Int      // e.g. 25 for 25%
  durationMinutes Int      // calculated minutes
  startOffsetMin  Int      // minute offset from startedAt
  endOffsetMin    Int      // minute offset from startedAt
  isNotified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([meetupId])
}

model MeetupTemplate {
  id                   String   @id @default(uuid())
  teamId               String   @default("default")
  ownerUserId          String
  name                 String
  channelId            String
  speakerUserId        String // Single ID or comma-separated IDs
  totalMinutes         Int
  destination          String   @default("auto") // auto, main (specific Huddle threads are never reusable)
  reminderTextEnabled  Boolean  @default(true)
  reminderImageEnabled Boolean  @default(false)
  modulesJson          String // JSON array of {title, percentage}
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([teamId, ownerUserId, name])
  @@index([teamId, ownerUserId])
}
