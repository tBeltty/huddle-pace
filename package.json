{
  "name": "huddle-pace",
  "version": "1.0.0",
  "description": "Slack-native meeting time tracker and speaker copilot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts",
    "db:push": "prisma db push",
